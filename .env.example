# Server-side only. Never prefix the key with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Any Responses API model supporting strict structured outputs can be configured.
OPENAI_MODEL=gpt-4.1-mini

# Speech output: browser (no key needed) or elevenlabs.
VOICE_PROVIDER=browser
# Server-side only. The voice ID must already exist in your ElevenLabs account.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
